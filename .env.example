# -------------------------------------------------------------
# ANKI DECK BUILDER - CONFIGURATION EXAMPLE
# -------------------------------------------------------------

# 1. AI PROVIDER (Chọn provider mặc định trên server: ltn | openai | custom)
AI_PROVIDER=ltn

# 2. LTN AI PROXY (https://ltnproxy.com/docs)
# Tốc độ cao, tối ưu cho xử lý dữ liệu và hỗ trợ reasoning models
LTN_API_KEY=sk-9qRozmPlVe2JkyVn9zg6plPXGCIieZFN
# Lưu ý: Bắt buộc endpoint OpenAI-compatible của LTN phải có đuôi /v1
OPENAI_URL=https://api.ltnproxy.com/v1
# Model gợi ý: gpt-5.6-luna (khuyên dùng), gemini-3.8-flash, claude-opus-5-5, deepseek-v4.1-flash
OPENAI_MODEL=gpt-5.6-luna

# 3. OPENAI OFFICIAL (https://platform.openai.com)
# Bỏ ghi chú nếu dùng API OpenAI chính thức:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_URL=https://api.openai.com/v1

# 4. CUSTOM OPENAI-COMPATIBLE PROXY (Ollama, vLLM, OpenCode, Proxy riêng)
# CUSTOM_AI_KEY=your_custom_key
# CUSTOM_AI_URL=http://localhost:11434/v1
# CUSTOM_AI_MODEL=gpt-4o-mini

# 5. MẬT KHẨU TRUY CẬP ỨNG DỤNG (Tùy chọn)
APP_PASSWORD=anki123
